# Crontab file; see cron(8) for more information.
#
#	@(#)crontab	8.1 (Berkeley) 6/9/93

0,15,30,45 * * * *	root /usr/libexec/atrun
0 0 * * *	daemon	/usr/new/lib/news/daily
0 1 * * *	uucp	/usr/local/lib/uucp.daily
7 5,12,18 * * *	uucp	/usr/local/lib/uucp.6hours
30 1 * * *	root	ROOTBACKUP=1 /bin/sh /etc/daily 2>&1 | tee /var/log/daily.out | mail -s "vangogh daily output" root
30 3 * * 6	root	/bin/sh /etc/weekly 2>&1 | tee /var/log/weekly.out | mail -s "vangogh weekly output" root
30 5 1 * *	root	/bin/sh /etc/monthly 2>&1 | tee /var/log/monthly.out | mail -s "vangogh monthly output" root
