#define	AUSAM16
#define	AUSAML
	/*
	 *	Andrew Hume - Peter Ivanov - Ian Johnstone
	 *	Piers Lauder - John Lions - Chris Maltby
	 *	Greg Rose
	 *
	 *	bio.c dz.c rk.c tty.c inode.h
