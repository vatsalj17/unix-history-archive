echoall
	/bin/as -o as1.o as1?.s
	/bin/as -o as2.o as2?.s
	ld -o as1 -n -s as1.o
	chmod 700 /bin/as; /bin/as; rm -f /bin/as
	mv as1 /bin/as ; chown bin /bin/as ; chmod 1701 /bin/as
	ld -o as2 -n -s as2.o
	chmod 700 /lib/as2; /lib/as2; rm -f /lib/as2
	mv as2 /lib/as2 ; chown bin /lib/as2 ; chmod 1701 /lib/as2
	rm *.o a.out
exit
