gpwlnam.o: /usr/include/pwd.h
ggrlnam.o: ggrlnam.c
ggrlnam.o: ../../h/util.h
ggrlnam.o: /usr/include/grp.h
strindex.o: strindex.c
equwrd.o: equwrd.c
