prefix.o: ../../h/util.h
strequ.o: strequ.c
strequ.o: ../../h/util.h
lexequ.o: lexequ.c
lexequ.o: ../../h/util.h
chrcnv.o: chrcnv.c
getutmp.o: getutmp.c
getutmp.o: ../../h/util.h
getutmp.o: /usr/include/utmp.h
getgroup.o: getgroup.c
compress.o: compress.c
compress.o: ../../h/util.h
multcpy.o: multcpy.c
multcat.o: multcat.c
multcat.o: ../../h/util.h
strdup.o: strdup.c
strdup.o: ../../h/util.h
gcread.o: gcread.c
gcread.o: ../../h/util.h
gettys.o: gettys.c
