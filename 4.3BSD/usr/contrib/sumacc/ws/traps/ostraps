        .PROC   Date2Secs,2

        MOVEA.L 8(SP),A0        ;A0=date
        _Date2Secs              ;D0=seconds elapsed
        MOVEM.L (SP)+,D1/A0-A1  ;D1=ret, A0=intptr, A1=date
