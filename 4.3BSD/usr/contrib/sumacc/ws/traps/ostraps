                .REF    SaveRetA1
;
                Move.L  (SP)+,A1        ;return address
                Move.L  (SP)+,A0        ;startPtr
                _SetApplBase            ;ask OS to do request
                JMP   SaveRetA1       ;save 0 result code and return via A1


