.\" @(#)c3.rpc.prog 1.1 85/04/09	Sun Microsystems
.OH 'RPC Programming''Page \\\\n(PN'
.EH 'Page \\\\n(PN''RPC Programming'
.OF 'Sun Microsystems''Release 2.0'
