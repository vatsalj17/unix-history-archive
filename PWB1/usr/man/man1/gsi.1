.th GSI I 5/31/77
.sh NAME
gsi \- handle special functions of GSI300 terminal
.sh SYNOPSIS
.bd gsi
[\fB+12\fR]
[\fB\-\fIn\fR]
[\fB\-d\fIt,l,c\fR]
.sh DESCRIPTION
.if n\{\
.s3
.ce
***NOTE***
