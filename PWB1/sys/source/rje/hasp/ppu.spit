//a	exec	spitcl,lib='r9152.load1',m=ppu
//sysin   dd   *
-noexecute
	load('parm()string')
	parm() break('/') len(1) rem $ rst
	rst "b=1"   . jes =
	o = 'a'
	rst "o=" (break(',') | rem) $ o
	rst ('usr=(' break(')') len(1)) $ usr  :f(err)s($o)
a	output("output","print")
	output = differ(jes) "   jes2 job log"
	output = '*    ' usr   :(end)
b	output("punch","punch")
	punch = differ(jes) "     jes2 job log"
	punch = '*    ' usr dupl(' ',74 - size(usr)) '!'  :(end)
err	&code = 16
end
/*
