9


RQUOTA(3R)          UNIX Programmer's Manual           RQUOTA(3R)



               Q_EPERM = 3         /* no permission to access quota */
          };
          struct getquota_rslt {
               enum gqr_status gqr_status;   /* discriminant */
               struct rquota gqr_rquota;     /* valid if status == Q_OK */
          };

SEE ALSO
     quota(1), quotactl(2)














































