


GETPWENT(3)         UNIX Programmer's Manual          GETPWENT(3)



NAME
     getpwent, getpwuid, getpwnam, setpwent, endpwent, setpwfile
     - get password file entry

SYNOPSIS
     #include <pwd.h>

     struct passwd *getpwuid(uid)
     int uid;

     struct passwd *getpwnam(name)
     char *name;

     struct passwd *getpwent()

     setpwent()

     endpwent()

     setpwfile(name)
     char *name;

DESCRIPTION
     _G_e_t_p_w_e_n_t, _g_e_t_p_w_u_i_d and _g_e_t_p_w_n_a_m each return a pointer to an
     object with the following structure containing the broken-
     out fields of a line in the password file.

          /*
           * RCS Info
           *   $Header: pwd.h,v 1.1 86/09/05 08:02:44 tadl Exp $
           *   $Locker: tadl $
           */
          /*   pwd.h     4.1  83/05/03  */

          struct    passwd { /* see getpwent(3) */
               char *pw_name;
               char *pw_passwd;
               int  pw_uid;
               int  pw_gid;
               int  pw_quota;
               char *pw_comment;
               char *pw_gecos;
               char *pw_dir;
               char *pw_shell;
          };

          struct passwd *getpwent(), *getpwuid(), *getpwnam();

     The fields _p_w__q_u_o_t_a and _p_w__c_o_m_m_e_n_t are  unused;  the  others
     have meanings described in _p_a_s_s_w_d(5).





