NAME
     setmntent, getmntent, addmntent, endmntent, hasmntopt - get
     file system descriptor file entry

SYNOPSIS
     #include <stdio.h>
     #include <mntent.h>
9     FILE *setmntent(filep, type)
     char *filep;
     char *type;
9     struct mntent *getmntent(filep)
