tmp=/tmp/toc$$
troff=vtroff
getNAME=getNAME
trap "rm $tmp ; exit" 2 3 15
if [ $# -eq 0 ]
then
	echo "Usage: $0 all, $0 setion-number, or $0 tr"
	exit 1
fi
if [ $# -eq 2 ]
then
	: create toc input file for one section only

	( cd ../man$1 ; $getNAME -t *.* |
		sed \
			-e 's/.s-1//g' \
			-e 's/.s0//g' \
			-e 's/.s+1//g' \
			-e 's/\.I  *//g' \
			-e 's/\.B  *//g' \
			-e 's/  *.-  */: /' \
			-e 's/ *$/./' \
			-e 's/.TH.*	//' \
		> ../man0/tocx$1
	)
else case $1 in
	all )
		:   tocx files for all sections and everything else

		for x in 1 2 3 4 5 6 7 8
			do
			$0 $x $x
			done
		$0 t
		;;
	t )
		:   permuted index and toc files

		if [ ! -f tocx1 ]
		then
			echo "tocx? files missing; must run $0 all first"
			exit
		fi
		sed \
			-e 's/(1c)/(1C)/' \
			-e 's/(1m)/(1M)/' \
			-e 's/(1g)/(1G)/' \
			-e 's/(3c)/(3C)/' \
			-e 's/(3m)/(3M)/' \
			-e 's/(3s)/(3S)/' \
			-e 's/(3f)/(3F)/' \
			-e '/^sh(1)/d' \
			-e '/"\."/d' \
			tocx? shcmd cshcmd \
		> /tmp/cattoc

		ptx -r -t -b break -f -w 88 -i ignore \
		    /tmp/cattoc >ptxindex
		rm /tmp/cattoc

		for x in 1 2 3 4 5 6 7 8
		do
			< tocx$x grep '^intro' >$tmp
				sed \
				-e '2,${' \
				-e '/^intro/d' \
				-e '}' \
				-e 's/ .*://' \
				-e 's/.$//' \
				-e 's/([^)]*) /" "/' \
				-e 's/.*/.xx "&"/' \
				-e '/""/d' \
				$tmp tocx$x \
			>toc$x
		done
		;;
	tr )
		$troff ptx.in
		$troff contents
		;;
	* )
		$0 $1 $1
		;;
	esac
fi
exit
