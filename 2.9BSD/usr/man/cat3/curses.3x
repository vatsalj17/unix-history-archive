     scanw(fmt,arg1,arg2,...)      scanf through _s_t_d_s_c_r
     scroll(win)                   scroll _w_i_n one line
     scrollok(win,boolf)           set scroll flag
     setterm(name)                 set term variables for name
     unctrl(ch)                    printable version of _c_h
