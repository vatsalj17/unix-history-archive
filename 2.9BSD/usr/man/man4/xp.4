	disk	start	length	cyls	function on drive 0
	xp?a	0	4800	0-29	/
	xp?b	4800	4800	30-59	swap
	xp?c	9600	122080	60-822	/usr
	xp?d	9600	62720	60-451	alternate
	xp?e	72320	59360	452-822	alternate
	xp?h	0	131680	0-822	whole pack
.PP
