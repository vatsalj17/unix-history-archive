	disk	start	length	cyls	function on drive 0
	xp?a	0	9120	  0-14	/
	xp?b	9120	9120	 15-29	swap
	xp?c	18240	234080	 30-414	
	xp?d	252320	248064	415-822	
	xp?e	18240	164160	 30-299	/usr
	xp?f	182400	152000	300-549	
