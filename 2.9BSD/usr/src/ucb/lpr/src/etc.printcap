#
# This is a sample of printcap entries used by various printers
#
# DecWriter over a tty line.
ap|arpa|ucbarpa|LA-180 DecWriter III:\
	:lp=/dev/ttyh0:br#1200:fs#06320:tr=\f:of=/usr/lib/ulf:\
	:lf=/usr/adm/lpd-errs:
lp|ucbvax|vax|vx|ucbvax line printer:\
	:lp=:sd=/usr/spool/vaxlpd:lf=/usr/adm/lpd-errs:
