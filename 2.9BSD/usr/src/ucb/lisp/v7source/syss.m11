		.psect	startc con
frstcl:	jmp	@where		;start things off 



	.mcall	$exit,$indir,$read,$write,$open,$close,$create,$switch,$sig


.if	ne,xfer
	.mcall	$fork,$exec,$kill,$ptrace,$wait
