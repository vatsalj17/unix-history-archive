atom	def,,,,xcdef

subrbeg	xcdef,nlambda,1
	chanl
	mov	@np,j2
	car	j2,a
.if	eq,multiset
 .if	ne,nilas0
	beq	def12$
.endc
.endc
	cmptype	a,j1,#natom	;make sure is atom
	bne	1$
	mov	@2(j2),4(a)	;store function binding
	ret
erm16er=* .
1$:	error	</only atoms have function definitions/>
.if	eq,multiseg
 .if	ne,nilas0
def12$:	mov	@2(j2),atmnil+4
	ret
.endc
.endc
subrend

