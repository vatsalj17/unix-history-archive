atom	readdmem,,,,xrdm

subrbeg	xrdm,lambda,1
	chanl
	mov	@np,a
	numga
	bit	#1,b
	bne	1$
	mov	(b),b
	br	2$
1$:	mov	np,b
	tst	a
	bge	2$
	mov	sp,b
