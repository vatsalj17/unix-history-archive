     22						.macro	strcpy	from,to ,?loop
     23						mov	r0,-(sp)
     24						mov	r1,-(sp)
     25						mov	from,r0
     26						mov	to,r1
     27					loop:
     28						movb	(r0)+,(r1)+
     29						bne	loop
     30					
     31						mov	(sp)+,r1
     32						mov	(sp)+,r0
     33						.endm
