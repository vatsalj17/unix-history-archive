      3					.macro	genchn	zchan,zlnk,zbuf,ztype,zext,zlen
      4						setchn	cmo,	cmo,	cmo,	0,	,80.
      5						setchn	src,	src,	src,	0,	m11,	132.
      6						setchn	lst,	lst,	lst,	,	lst,	512.
      7						setchn	obj,	obj,	obj,	1,	obj,	42.
      8						.if ndf	xsml
      9						setchn	sml,	sml,	sml,	0,	sml,	80.
     10						.endc
     11						.if ndf xcref
